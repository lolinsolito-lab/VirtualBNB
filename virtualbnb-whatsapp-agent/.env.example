# WhatsApp Cloud API (Meta for Developers > il tuo App > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=una-stringa-a-caso-scelta-da-te

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# AI provider (default Claude — vedi lib/aiService.js)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Il tuo numero, formato E.164 senza '+' (es. 393331234567) — dove arrivano le notifiche
MIKE_NOTIFY_PHONE=
